# Example environment configuration for Tripline Phase 1

# ArmorIQ Configuration
# API key generated at platform.armoriq.ai
ARMORIQ_API_KEY=ak_live_your_armoriq_key_here

# LLM Provider Configuration (set at least one provider)
# Preferred for low cost and native tool calling
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Tripline Gateway & Server Configuration
TRIPLINE_MCP_URL=http://127.0.0.1:8000/mcp
TRIPLINE_FIXTURES_DIR=fixtures
